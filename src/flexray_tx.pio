; PiFlex-FW - FlexRay MITM bit-mirror bridge (TX path).
; SPDX-License-Identifier: GPL-3.0-or-later
;
; Clean-room repeater written from the FlexRay line coding (idle / TSS / FSS /
; BSS / FES) and the NCV7383 datasheet - not derived from any third-party
; firmware.
;
; One state machine per bridge direction. It transparently repeats the bits it
; sees on a source RXD line onto a destination TXD line, asserting that channel's
; TXEN (active-LOW) for the duration of a frame so the destination transceiver
; drives the bus. Two SMs (FR1->FR2 and FR2->FR1) make the full MITM bridge.
;
; Pin groups (set per direction in flexray_tx_program_init):
;   IN / jmp pin : source RXD        (the channel we listen to; read-only)
;   OUT pin      : destination TXD    (driven by `mov pins, pins`, one bit)
;   SET pin      : destination TXEN   (active-low: 0 = drive bus, 1 = release)
;   gate pin     : the pin at IN_base + 1 (read at arm; see HALF-DUPLEX below)
;
; Line coding this program keys off:
;   idle = sustained high ; TSS = long low run (the F11 car uses 9 bits) ;
;   FSS  = one high bit ; byte = BSS "10" + 8 data bits ; FES = "01" then idle.
;
; COPY TIMING (why the loop is kept tight):
;   The SM runs at clk_sys (clkdiv 1.0) and copies RXD->TXD once per replay pass.
;   A pass is 4 cycles when the line is high, 5 when low: ~27-33 ns at 150 MHz,
;   i.e. the line is re-sampled ~3-4x per 100 ns bit. That bounds the quantization
;   of each reproduced edge to well under a bit cell, so a receiver sampling at
;   bit centre never catches a mis-timed transition. (An earlier build stretched
;   the copy to ~6-7 cycles / ~40-47 ns - only ~2x per bit - and ~10-15% of frames
;   flipped a single bit next to a transition because edges quantized by ~half a
;   bit. Keeping the copy at 4-5 cycles is what makes the mirror byte-exact, so do
;   not add delay to `mov pins, pins`.) Derivation mirrors the RX trim: 10 Mbit/s
;   = 100 ns/bit, and the sampler must step several times finer than that.
;
; TXEN arming / release:
;   - Require a sustained idle (N_HIGH consecutive highs, where N_HIGH, from C,
;     exceeds the 9-bit worst-case in-frame high run) so we only arm at a real
;     frame boundary.
;   - Arm on the first falling edge after idle (idle -> TSS), subject to the
;     half-duplex gate. TXEN is asserted before the first mirrored low reaches
;     TXD, so the full 9-bit TSS is reproduced from its leading edge.
;   - Release TXEN when the line is high for N_HIGH again (FES "01" then idle),
;     OR when the per-frame watchdog expires.
;
; HALF-DUPLEX arbitration (stops reverse-echo contention):
;   A bidirectional repeater can hear its own output - the NCV7383 reflects TXD
;   onto RXD while transmitting - so a frame one direction forwards reads back on
;   the source channel and the other direction would re-forward it. FlexRay is
;   TDMA (one transmitter per slot), so per-frame half-duplex is correct: first
;   direction to see idle->TSS wins; the other stays muted until FES. At arm we
;   read the gate pin at IN_base + 1: if LOW the other direction is driving this
;   channel (its TXEN is asserted, active-low) and the TSS is our own readback ->
;   abort and stay idle (muted); if HIGH we win -> arm. The pin map lands this for
;   free: FR1_RXD(26)+1 == FR1_TXEN(27), so the FR1->FR2 forwarder's gate IS the
;   FR2->FR1 forwarder's TXEN. (For FR2->FR1 the gate pin is a spare GPIO held
;   high by C = not muted; driving it from the FR1->FR2 TXEN would complete the
;   symmetric reverse gate - a documented follow-up.)
;   REFRACTORY (stops re-circulation / ping-pong): the gate is checked not just at
;   arm but throughout idle-confirm - the gate must stay high for the whole confirm
;   window before we arm. The other direction's TXEN only goes high when it RELEASES,
;   so the readback of a frame this bridge just forwarded (which re-triggers right
;   after FES) is skipped: the gate has not been high long enough. A genuine new
;   frame comes from a real node with the gate high throughout, so it still forwards
;   - that is how the echo is told apart from real back-to-back slot traffic.
;
; ANTI-OSCILLATION watchdog (safety backstop):
;   The gate cannot stop a simultaneous double-arm (both directions arming within
;   the few-cycle arm window, before either asserts TXEN). A whole-frame WATCHDOG
;   caps TXEN assertion so a latched feedback loop is force-released; collapsing
;   one direction removes the other's input signal and it releases too. The cap
;   is built in-SM as ~16383 passes (~0.5 ms, >> the ~264 us longest real frame),
;   so real frames are never truncated. <<TUNE>> via the shift amount below.
;
; Register use: ISR = N_HIGH (from C, pristine reload for the high counters);
; OSR = scratch (gate-bit extraction, then watchdog build); x = high-run / idle
; counter; y = watchdog counter.

.program flexray_tx

; Optional side-set drives the FLAG pin in lock-step with TXEN, mirroring this
; SM's transmit-active state onto the pin the OTHER direction reads as its gate.
; For FR1->FR2 the flag pin IS the far side's gate (FR2_RXD+1 = GP7); for FR2->FR1
; the flag pin is its own TXEN (redundant), so the far side already reads it on
; FR1_RXD+1 = FR1_TXEN. Side-set rides in the instruction's delay field, so it
; adds no cycles - the byte-exact replay copy is untouched.
.side_set 1 opt

    pull block               ; OSR <- N_HIGH (idle/FES high-pass count, from C)
    mov isr, osr             ; ISR = N_HIGH (reload source for x)

init_idle:
    set pins, 1    side 1    ; TXEN released (inactive high); flag high = not driving
confirm_idle:
    set x, 27                ; idle/refractory passes (~11 bits at this 6-cycle
                             ; confirm loop; keep <= the min inter-frame gap so a
                             ; real next frame is not dropped). <<TUNE>>
confirm_lp:
    jmp pin confirm_gate     ; line high -> also require the gate high (refractory)
    jmp confirm_idle         ; line low -> not idle yet, restart the count
confirm_gate:
    ; REFRACTORY: require the gate pin (IN_base + 1) high for the whole confirm
    ; window, not just at arm. The gate is the other direction's TXEN (active-low);
    ; it only goes high once that direction RELEASES, so a frame this bridge just
    ; forwarded is still reading back while the gate has not yet been high long
    ; enough -> we skip our own echo. A genuine new frame on this channel comes
    ; from a real node with the gate high throughout, so it is NOT skipped.
    mov osr, pins            ; sample pins (bit0 = RXD, bit1 = gate)
    out null, 1              ; drop the RXD bit (OUT shifts right, LSB first)
    out y, 1                 ; y = gate bit
    jmp !y confirm_idle      ; gate low (other driving / just released) -> restart
    jmp x-- confirm_lp       ; RXD high AND gate high -> count toward confirmed
wait_tss:
    jmp pin wait_tss         ; spin while high; falls through on the falling edge
    ; Final gate recheck at the TSS edge (closes the confirm->arm race): extract
    ; the pin at IN_base + 1. RXD (IN_base) is low here, so OUT-right discards it.
    mov osr, pins            ; OSR bit0 = RXD (low), bit1 = gate
    out null, 1              ; drop the RXD bit
    out x, 1                 ; x = gate bit
    jmp !x init_idle         ; gate low -> other direction active -> stay muted
    ; We win the bridge. Build the watchdog and arm.
    mov osr, ~null           ; OSR = 0xFFFFFFFF
    out null, 18             ; keep 14 bits -> 0x3FFF = 16383 passes  <<TUNE>>
    mov y, osr               ; y = watchdog limit (whole-frame TXEN cap)
    set pins, 0    side 0    ; assert TXEN (drive the bus); flag low = driving
    mov x, isr               ; reset the high-run counter for the frame
replay:
    mov pins, pins           ; copy source RXD -> destination TXD (one sample)
    jmp y-- wd_ok            ; watchdog tick; expired -> force release
    jmp init_idle            ; watchdog hit 0 -> break any feedback latch
wd_ok:
    jmp pin high_run         ; line high? -> count it toward end-of-frame
    mov x, isr               ; line low -> reset the high-run counter, keep going
    jmp replay
high_run:
    jmp x-- replay           ; still < N_HIGH consecutive highs -> keep replaying
    jmp init_idle            ; N_HIGH highs -> FES + idle, release and re-confirm

% c-sdk {
#include "hardware/clocks.h"

// Initialise one MITM bridge state machine.
//   in_pin   : source RXD   (listened to; this SM does not own its funcsel).
//              The half-duplex gate pin is in_pin + 1 (read at arm).
//   txd_pin  : destination TXD  (driven, one bit, by `mov pins, pins`)
//   txen_pin : destination TXEN (driven by `set pins`; active-low)
//   flag_pin : side-set output mirroring this SM's TXEN (active-low) so the OTHER
//              direction can read it as its gate at the other channel's IN+1.
//              For FR1->FR2 this is the far gate GP7; for FR2->FR1 it is its own
//              TXEN (redundant, the far side reads the real TXEN pin).
//   idle_bits: sustained-high bit count marking idle / end-of-frame (> 9).
static inline void flexray_tx_program_init(PIO pio, uint sm, uint offset,
                                           uint in_pin, uint txd_pin,
                                           uint txen_pin, uint flag_pin,
                                           uint idle_bits) {
    pio_sm_config c = flexray_tx_program_get_default_config(offset);

    // Source line + gate: `mov pins, pins` copies IN_base (RXD); `mov osr, pins`
    // samples IN_base (RXD, bit0) and IN_base+1 (gate, bit1). jmp pin = RXD.
    sm_config_set_in_pins(&c, in_pin);
    sm_config_set_jmp_pin(&c, in_pin);
    // Destination TXD: written by `mov pins, pins` (OUT group), one bit.
    sm_config_set_out_pins(&c, txd_pin, 1);
    // Destination TXEN: written by `set pins`, one bit.
    sm_config_set_set_pins(&c, txen_pin, 1);
    // Flag: side-set drives flag_pin in lock-step with TXEN (the far gate).
    sm_config_set_sideset_pins(&c, flag_pin);
    // OUT shifts right (LSB first) so the gate extraction discards RXD then reads
    // the gate bit. No autopull/autopush - N_HIGH is pulled once.
    sm_config_set_out_shift(&c, true /* shift right */, false /* no autopull */, 32);

    // TX owns the output pins' GPIO function. The source RXD is left to the RX
    // decoder's pio_gpio_init - a second PIO can still sample the pad input.
    pio_gpio_init(pio, txd_pin);
    pio_gpio_init(pio, txen_pin);
    pio_gpio_init(pio, flag_pin);
    pio_sm_set_consecutive_pindirs(pio, sm, txd_pin, 1, true /* output */);
    pio_sm_set_consecutive_pindirs(pio, sm, txen_pin, 1, true /* output */);
    pio_sm_set_consecutive_pindirs(pio, sm, flag_pin, 1, true /* output */);

    // Run at the full system clock for the lowest copy latency (see header).
    sm_config_set_clkdiv(&c, 1.0f);

    pio_sm_init(pio, sm, offset, &c);

    // Drive outputs to idle (TXEN released high, TXD idle high, flag high = not
    // driving) before the SM runs, so handing the pins to PIO cannot glitch low.
    const uint32_t idle_mask = (1u << txd_pin) | (1u << txen_pin) | (1u << flag_pin);
    pio_sm_set_pins_with_mask(pio, sm, idle_mask, idle_mask);

    // N_HIGH in replay passes (~4 cycles each): idle_bits of 100 ns line /
    // (4 / clk_sys). Full register value (not a set immediate), so the copy loop
    // stays tight.
    const uint32_t clk = clock_get_hz(clk_sys);
    uint32_t n_high = (uint32_t)(((uint64_t)idle_bits * 100ull * clk) / 4000000000ull);
    if (n_high < 1) n_high = 1;
    pio_sm_put(pio, sm, n_high);     // consumed by the program's one-shot `pull`

    pio_sm_set_enabled(pio, sm, true);
}
%}
