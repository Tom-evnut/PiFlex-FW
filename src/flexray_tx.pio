; PiFlex-FW - FlexRay MITM bit-mirror bridge (TX path).
; SPDX-License-Identifier: GPL-3.0-or-later
;
; Clean-room repeater written from the FlexRay line coding (idle / TSS / FSS /
; BSS / FES) and the NCV7383 datasheet - not derived from any third-party
; firmware.
;
; One state machine per bridge direction. It transparently repeats the bits it
; sees on a source RXD line onto a destination TXD line, asserting that channel's
; TXEN (active-LOW) for the duration of a frame so the destination transceiver
; drives the bus. Forwarding is UNCONDITIONAL: there is no sync / startup /
; slot-ID gate. TXEN arms on the physical idle -> TSS pattern and releases when
; the line returns to idle at the FES. Two SMs (FR1->FR2 and FR2->FR1) make the
; full MITM bridge; they run independently.
;
; Pin groups (set per direction in flexray_tx_program_init):
;   IN / jmp pin : source RXD        (the channel we listen to; read-only)
;   OUT pin      : destination TXD    (driven by `mov pins, pins`, one bit)
;   SET pin      : destination TXEN   (active-low: 0 = drive bus, 1 = release)
;
; Line coding this program keys off:
;   idle = sustained high ; TSS = long low run (the F11 car uses 9 bits) ;
;   FSS  = one high bit ; byte = BSS "10" + 8 data bits ; FES = "01" then idle.
;
; TXEN arming / release:
;   - Require a sustained idle (>= FR_TX_IDLE_BITS consecutive highs) so we only
;     arm at a real frame boundary, never on a high run inside a frame. The 8
;     data bits + the following BSS high give a worst-case in-frame high run of
;     9 bits, so the idle threshold must exceed 9 bits.
;   - Arm on the first falling edge after idle (idle -> TSS). TXEN is asserted
;     (SET pins 0) one-to-two SM cycles after that edge, i.e. before the first
;     mirrored low reaches TXD, so the full TSS low run is reproduced.
;   - The 9-bit TSS is PRODUCED by replaying the source's own 9-bit TSS verbatim:
;     because we arm on the leading edge (not after counting TSS bits) the output
;     TSS loses only the ~1-cycle detection latency, so a 9-bit input TSS comes
;     out ~9 bits long. (The bench failure where a 2-bit TSS did not forward was
;     a short TSS at the source, not shaving added here.)
;   - Release TXEN when the line has been high for >= FR_TX_IDLE_BITS again: the
;     FES "01" is followed by idle, so a sustained high past the 9-bit worst case
;     marks end-of-frame. The SM then returns to idle with TXEN released (high).
;
; TIMING: the SM runs at clk_sys (clkdiv 1.0) so the replay loop copies the line
; with the lowest possible latency. Each pass of the replay loop is 3 (line high)
; or 4 (line low) cycles; at 150 MHz that is a 20-27 ns copy latency, under 1/4 of
; a 100 ns bit, so edges are reproduced faithfully. The idle/FES high threshold y
; is a count of 3-cycle high passes, computed from FR_TX_IDLE_BITS in C.
; Values marked <<TUNE>> are paper-derived and get trimmed on the bench.

.program flexray_tx

    ; One-time setup: load the sustained-high sample threshold N into y.
    pull block               ; OSR <- N (from the TX FIFO, pushed by C at init)
    mov y, osr               ; y = N, the idle / end-of-frame high-pass count

.wrap_target
idle:
    set pins, 1              ; TXEN released (inactive high) - destination in RX
confirm_idle:
    mov x, y                 ; reload the high-pass counter
confirm_lp:
    jmp pin confirm_cont     ; line still high -> keep counting toward idle
    jmp confirm_idle         ; went low too soon -> not idle yet, restart count
confirm_cont:
    jmp x-- confirm_lp [1]   ; N high passes (3 cycles each) -> idle confirmed
    ; Line is idle-high. Wait for the TSS falling edge = start of a frame.
wait_tss:
    jmp pin wait_tss         ; spin while high; falls through on the falling edge
    set pins, 0              ; arm: assert TXEN (drive the destination bus)
replay:
    mov pins, pins           ; copy source RXD -> destination TXD (one sample)
    jmp pin high_run         ; line high? -> count it toward end-of-frame
    mov x, y                 ; line low -> reset the high-run counter, keep going
    jmp replay
high_run:
    jmp x-- replay           ; still < N consecutive highs -> keep replaying
    ; N consecutive highs -> FES + idle reached, frame over.
.wrap                        ; back to idle: release TXEN, re-confirm idle

% c-sdk {
#include "hardware/clocks.h"

// Initialise one MITM bridge state machine.
//   in_pin   : source RXD   (listened to; this SM does not own its GPIO funcsel)
//   txd_pin  : destination TXD  (driven, one bit, by `mov pins, pins`)
//   txen_pin : destination TXEN (driven by `set pins`; active-low)
//   idle_bits: sustained-high bit count marking idle / end-of-frame (> 9).
static inline void flexray_tx_program_init(PIO pio, uint sm, uint offset,
                                           uint in_pin, uint txd_pin,
                                           uint txen_pin, uint idle_bits) {
    pio_sm_config c = flexray_tx_program_get_default_config(offset);

    // Source line: read by `mov pins, pins` (IN group) and by `jmp pin`.
    sm_config_set_in_pins(&c, in_pin);
    sm_config_set_jmp_pin(&c, in_pin);
    // Destination TXD: written by `mov pins, pins` (OUT group), one bit.
    sm_config_set_out_pins(&c, txd_pin, 1);
    // Destination TXEN: written by `set pins`, one bit.
    sm_config_set_set_pins(&c, txen_pin, 1);
    // Manual one-shot pull of the threshold; no autopull.
    sm_config_set_out_shift(&c, false /* shift left */, false /* no autopull */, 32);

    // TX owns the two output pins' GPIO function. The source RXD is left to the
    // RX decoder's pio_gpio_init - a second PIO can still sample the pad input.
    pio_gpio_init(pio, txd_pin);
    pio_gpio_init(pio, txen_pin);
    pio_sm_set_consecutive_pindirs(pio, sm, txd_pin, 1, true /* output */);
    pio_sm_set_consecutive_pindirs(pio, sm, txen_pin, 1, true /* output */);

    // Run at the full system clock for the lowest copy latency (see header).
    sm_config_set_clkdiv(&c, 1.0f);

    pio_sm_init(pio, sm, offset, &c);

    // Drive both outputs to their idle state (TXEN released high, TXD idle high)
    // before the SM runs, so handing the pins to PIO cannot glitch TXEN low.
    pio_sm_set_pins_with_mask(pio, sm,
                              (1u << txd_pin) | (1u << txen_pin),
                              (1u << txd_pin) | (1u << txen_pin));

    // Threshold N = idle_bits of high line / (3 SM cycles per high pass).
    // high-pass time = 3 / clk_sys ; idle_bits * 100 ns must exceed it N times.
    const uint32_t clk = clock_get_hz(clk_sys);
    uint32_t n = (uint32_t)(((uint64_t)idle_bits * 100ull * clk) / 3000000000ull);
    if (n < 1) n = 1;
    pio_sm_put(pio, sm, n);          // consumed by the program's one-shot `pull`

    pio_sm_set_enabled(pio, sm, true);
}
%}
